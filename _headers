# Netlify custom headers.
#
# The Functional Goals PDF is the same words as /functional-goals, rendered for
# print. It is a handout to attach to an email, not a second page to rank — and
# an indexed duplicate would compete with the page it came from. An X-Robots-Tag
# header travels with the file; a robots.txt Disallow does
# not stop an indexed URL.
/functional-goals.pdf
  X-Robots-Tag: noindex
